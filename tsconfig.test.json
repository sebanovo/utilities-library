{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "outDir": "./dist/tests",
    "esModuleInterop": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": ["tests/**/*.ts", "src/**/*.ts"]
}
